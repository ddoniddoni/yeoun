{
  "name": "yeoun-camera",
  "version": "0.0.1",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --watch=false",
    "test:unit": "jest tests/unit --watch=false",
    "test:integration": "jest tests/integration --watch=false",
    "validate:filters": "node scripts/validate-filter-seed.mjs",
    "generate:luts": "node scripts/generate-luts.mjs",
    "validate:filter-assets": "node scripts/validate-filter-assets.mjs",
    "build:js": "expo export --platform ios --output-dir dist/ios && expo export --platform android --output-dir dist/android"
  },
  "dependencies": {
    "@shopify/react-native-skia": "2.4.18",
    "expo": "55.0.32",
    "expo-asset": "55.0.20",
    "expo-build-properties": "55.0.18",
    "expo-crypto": "55.0.19",
    "expo-dev-client": "55.0.41",
    "expo-file-system": "55.0.26",
    "expo-media-library": "55.0.21",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-nitro-image": "0.15.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-vision-camera": "5.2.3",
    "react-native-vision-camera-skia": "5.2.3",
    "react-native-vision-camera-worklets": "5.2.3",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.18",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.5",
    "eslint-config-expo": "55.0.1",
    "jest": "29.7.0",
    "jest-expo": "55.0.22",
    "pngjs": "7.0.0",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "@shopify/react-native-skia@2.4.18": true
  }
}
